{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Machine-only query revision proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "proposal_version",
    "profile",
    "task_binding",
    "human_gold",
    "generator",
    "items",
    "report_id"
  ],
  "properties": {
    "artifact_type": {
      "const": "query_revision_proposals"
    },
    "proposal_version": {
      "const": "1"
    },
    "profile": {
      "const": "literal_review_rules_v1"
    },
    "task_binding": {
      "type": "object"
    },
    "human_gold": {
      "const": false
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "llm_calls",
        "config_sha256",
        "implementation_sha256"
      ],
      "properties": {
        "kind": {
          "const": "offline_rules"
        },
        "llm_calls": {
          "const": 0
        },
        "config_sha256": {
          "type": "string",
          "minLength": 1
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_atom_id",
          "source_atom_sha256",
          "status",
          "reason_code",
          "machine_rationale",
          "evidence",
          "operation",
          "replacement_atoms",
          "semantic_kind"
        ],
        "properties": {
          "source_atom_id": {
            "type": "string",
            "minLength": 1
          },
          "source_atom_sha256": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "proposed",
              "unresolved"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "machine_rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "start",
                "end",
                "quote",
                "query_sha256"
              ],
              "properties": {
                "source": {
                  "const": "query_text"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "query_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "operation": {
            "enum": [
              "retain",
              "none",
              "modify",
              "split",
              "reject"
            ]
          },
          "replacement_atoms": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "semantic_kind": {
            "type": "string",
            "minLength": 1
          },
          "legacy_advisory": {
            "type": "object"
          }
        }
      }
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
