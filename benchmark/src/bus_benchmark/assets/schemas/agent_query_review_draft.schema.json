{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/agent_query_review_draft.schema.json",
  "title": "Source-bound machine-only query-oracle semantic review draft",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "decision_status",
    "agent_generated",
    "human_gold",
    "human_submission_populated",
    "review_policy",
    "review_level",
    "source_bindings",
    "reviews",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_type": {"const": "agent_query_oracle_semantic_review_draft"},
    "artifact_id": {"$ref": "#/definitions/sha256"},
    "decision_status": {"const": "draft"},
    "agent_generated": {"const": true},
    "human_gold": {"const": false},
    "human_submission_populated": {"const": false},
    "review_policy": {"const": "one_complete_human_gold_per_subject"},
    "review_level": {"const": "intent_semantic_review_plus_subject_decision_expansion"},
    "source_bindings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": [
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "development_query_library"},
                "path": {"const": "query_lib/bus_ego_topdown_2d_dev_query_library_v0_2.jsonl"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "development_oracle_draft"},
                "path": {"const": "benchmark_artifacts/drafts/dev_oracle_draft.jsonl"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "test_query_library"},
                "path": {"const": "query_lib/bus_ego_topdown_2d_query_library_v0_2.jsonl"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "test_oracle_draft"},
                "path": {"const": "benchmark_artifacts/drafts/test_oracle_draft.jsonl"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "agent_review_fragment"},
                "path": {"const": "benchmark_artifacts/drafts/agent_review_fragments/dev_intents.json"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "agent_review_fragment"},
                "path": {"const": "benchmark_artifacts/drafts/agent_review_fragments/test_A_C_intents.json"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/source_binding"},
            {
              "properties": {
                "role": {"const": "agent_review_fragment"},
                "path": {"const": "benchmark_artifacts/drafts/agent_review_fragments/test_D_G_intents.json"}
              }
            }
          ]
        }
      ],
      "additionalItems": false
    },
    "reviews": {
      "type": "array",
      "minItems": 300,
      "maxItems": 300,
      "items": {"$ref": "#/definitions/review"}
    },
    "summary": {"$ref": "#/definitions/summary"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding": {
      "type": "object",
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {
          "enum": [
            "development_query_library",
            "development_oracle_draft",
            "test_query_library",
            "test_oracle_draft",
            "agent_review_fragment"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "scope",
        "target_type",
        "target",
        "recommendation",
        "reason",
        "suggested_change"
      ],
      "properties": {
        "finding_id": {"$ref": "#/definitions/sha256"},
        "scope": {"enum": ["all_surfaces", "precise", "partial", "vague"]},
        "target_type": {
          "enum": ["required_check", "atom_predicate", "cpd_policy", "oracle_record"]
        },
        "target": {"type": "string", "minLength": 1},
        "recommendation": {"enum": ["accept", "revise", "reject", "human_judgment"]},
        "reason": {"type": "string", "minLength": 1},
        "suggested_change": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["recommendation", "basis", "finding_ids", "reason"],
      "properties": {
        "recommendation": {
          "enum": [
            "accept_current",
            "revise_current",
            "reject_current",
            "human_judgment_required"
          ]
        },
        "basis": {"enum": ["intent_semantic_finding", "source_projection_default"]},
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/sha256"}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "atom_decision": {
      "type": "object",
      "required": ["atom_id", "predicate", "recommendation", "basis", "finding_ids", "reason"],
      "properties": {
        "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "predicate": {"type": "string", "minLength": 1},
        "recommendation": {
          "enum": [
            "accept_current",
            "revise_current",
            "reject_current",
            "human_judgment_required"
          ]
        },
        "basis": {"enum": ["intent_semantic_finding", "source_projection_default"]},
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/sha256"}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "query_id",
        "intent_group_id",
        "surface_style",
        "source_query_sha256",
        "source_oracle_sha256",
        "source_intent_review_sha256",
        "overall_disposition",
        "confidence",
        "semantic_findings",
        "required_check_decisions",
        "atom_decisions",
        "cpd_decision",
        "explicit_decision_entries",
        "human_action_required"
      ],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "intent_group_id": {"type": "string", "minLength": 1},
        "surface_style": {"enum": ["precise", "partial", "vague"]},
        "source_query_sha256": {"$ref": "#/definitions/sha256"},
        "source_oracle_sha256": {"$ref": "#/definitions/sha256"},
        "source_intent_review_sha256": {"$ref": "#/definitions/sha256"},
        "overall_disposition": {"enum": ["accept", "accept_with_attention", "revise"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "semantic_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/finding"}
        },
        "required_check_decisions": {
          "type": "object",
          "required": [
            "support_and_response_disposition",
            "cardinality_and_polarity",
            "road_and_spatial_decomposition",
            "event_graph_and_actor_binding",
            "surface_layering",
            "cpd_common_eligibility"
          ],
          "properties": {
            "support_and_response_disposition": {"$ref": "#/definitions/decision"},
            "cardinality_and_polarity": {"$ref": "#/definitions/decision"},
            "road_and_spatial_decomposition": {"$ref": "#/definitions/decision"},
            "event_graph_and_actor_binding": {"$ref": "#/definitions/decision"},
            "surface_layering": {"$ref": "#/definitions/decision"},
            "cpd_common_eligibility": {"$ref": "#/definitions/decision"}
          },
          "additionalProperties": false
        },
        "atom_decisions": {
          "type": "array",
          "items": {"$ref": "#/definitions/atom_decision"}
        },
        "cpd_decision": {"$ref": "#/definitions/decision"},
        "explicit_decision_entries": {"type": "integer", "minimum": 7},
        "human_action_required": {"const": true}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "intent_groups",
        "subjects",
        "atom_decisions",
        "required_check_decisions",
        "cpd_decisions",
        "explicit_decision_entries",
        "overall_disposition_counts",
        "recommendation_counts",
        "basis_counts",
        "admissible_human_gold_records_created"
      ],
      "properties": {
        "intent_groups": {"const": 100},
        "subjects": {"const": 300},
        "atom_decisions": {"type": "integer", "minimum": 0},
        "required_check_decisions": {"const": 1800},
        "cpd_decisions": {"const": 300},
        "explicit_decision_entries": {"type": "integer", "minimum": 2100},
        "overall_disposition_counts": {
          "type": "object",
          "required": ["accept", "accept_with_attention", "revise"],
          "properties": {
            "accept": {"type": "integer", "minimum": 0},
            "accept_with_attention": {"type": "integer", "minimum": 0},
            "revise": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "recommendation_counts": {
          "type": "object",
          "required": [
            "accept_current",
            "revise_current",
            "reject_current",
            "human_judgment_required"
          ],
          "properties": {
            "accept_current": {"type": "integer", "minimum": 0},
            "revise_current": {"type": "integer", "minimum": 0},
            "reject_current": {"type": "integer", "minimum": 0},
            "human_judgment_required": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "basis_counts": {
          "type": "object",
          "required": ["intent_semantic_finding", "source_projection_default"],
          "properties": {
            "intent_semantic_finding": {"type": "integer", "minimum": 0},
            "source_projection_default": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "admissible_human_gold_records_created": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
