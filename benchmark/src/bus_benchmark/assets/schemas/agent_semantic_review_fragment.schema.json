{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/agent_semantic_review_fragment.schema.json",
  "title": "Machine-only intent-level semantic review fragment",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "agent_generated",
    "human_gold",
    "scope",
    "intent_reviews",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_type": {"const": "agent_semantic_review_fragment"},
    "agent_generated": {"const": true},
    "human_gold": {"const": false},
    "scope": {
      "type": "object",
      "required": ["split", "library_path", "oracle_path", "intent_range"],
      "properties": {
        "split": {"enum": ["development", "test"]},
        "library_path": {"type": "string", "minLength": 1},
        "oracle_path": {"type": "string", "minLength": 1},
        "intent_range": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "intent_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/intent_review"}
    },
    "summary": {
      "type": "object",
      "required": ["intent_count", "disposition_counts"],
      "properties": {
        "intent_count": {"type": "integer", "minimum": 1},
        "disposition_counts": {
          "type": "object",
          "required": ["accept", "accept_with_attention", "revise"],
          "properties": {
            "accept": {"type": "integer", "minimum": 0},
            "accept_with_attention": {"type": "integer", "minimum": 0},
            "revise": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "scope",
        "target_type",
        "target",
        "recommendation",
        "reason",
        "suggested_change"
      ],
      "properties": {
        "scope": {"enum": ["all_surfaces", "precise", "partial", "vague"]},
        "target_type": {
          "enum": ["required_check", "atom_predicate", "cpd_policy", "oracle_record"]
        },
        "target": {"type": "string", "minLength": 1},
        "recommendation": {"enum": ["accept", "revise", "reject", "human_judgment"]},
        "reason": {"type": "string", "minLength": 1},
        "suggested_change": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "intent_review": {
      "type": "object",
      "required": [
        "intent_group_id",
        "query_ids",
        "overall_disposition",
        "confidence",
        "semantic_findings"
      ],
      "properties": {
        "intent_group_id": {"type": "string", "minLength": 1},
        "query_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "overall_disposition": {"enum": ["accept", "accept_with_attention", "revise"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "semantic_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/finding"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
