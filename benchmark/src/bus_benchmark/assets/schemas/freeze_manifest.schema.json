{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/freeze_manifest.schema.json",
  "title": "Hash-addressed benchmark freeze manifest",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_version",
    "created_at_utc",
    "status",
    "unfinished_decision_count",
    "unfinished_decision_paths",
    "assets",
    "protocol",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["draft", "frozen"]},
    "unfinished_decision_count": {"type": "integer", "minimum": 0},
    "unfinished_decision_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "freeze_asset.schema.json"},
      "uniqueItems": true
    },
    "protocol": {"$ref": "freeze_protocol.schema.json"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "frozen"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "unfinished_decision_count": {"const": 0},
          "unfinished_decision_paths": {"maxItems": 0},
          "assets": {"minItems": 19}
        }
      }
    }
  ],
  "additionalProperties": false
}
