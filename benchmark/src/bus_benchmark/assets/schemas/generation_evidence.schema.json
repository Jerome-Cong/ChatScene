{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/generation_evidence.schema.json",
  "title": "Immutable per-run generation evidence",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "method_id",
    "platform",
    "query_id",
    "intent_group_id",
    "statistical_intent_cluster_id",
    "surface_style",
    "repetition",
    "expected_support",
    "terminal_status",
    "request_sha256",
    "config_sha256",
    "implementation_bundle_sha256",
    "response_record_sha256",
    "raw_artifact",
    "finalization",
    "failure_reason"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "query_id": {"type": "string", "minLength": 1},
    "intent_group_id": {"type": "string", "minLength": 1},
    "statistical_intent_cluster_id": {"type": "string", "minLength": 1},
    "surface_style": {"enum": ["precise", "partial", "vague"]},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 4},
    "expected_support": {"enum": ["supported", "unsupported"]},
    "terminal_status": {"enum": ["complete", "failed", "timeout"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_artifact": {
      "oneOf": [{"type": "null"}, {"$ref": "#/definitions/fileBinding"}]
    },
    "finalization": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/definitions/completedFinalization"},
        {"$ref": "#/definitions/failedFinalization"}
      ]
    },
    "failure_reason": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"terminal_status": {"const": "complete"}},
        "required": ["terminal_status"]
      },
      "then": {"properties": {"failure_reason": {"type": "null"}}},
      "else": {"properties": {"failure_reason": {"type": "string", "minLength": 1}}}
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "completedFinalization": {
      "type": "object",
      "required": ["policy_id", "status", "raw_sha256", "final_sha256", "diff", "changes"],
      "properties": {
        "policy_id": {"enum": ["carla_ego_proxy_v0.1", "metadrive_pg_ego_proxy_v0.1"]},
        "status": {"const": "complete"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "final_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "diff": {"$ref": "#/definitions/fileBinding"},
        "changes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ego_blueprint",
              "ego_length_m",
              "ego_width_m",
              "ego_vehicle_model"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "failedFinalization": {
      "type": "object",
      "required": [
        "policy_id",
        "status",
        "raw_sha256",
        "final_sha256",
        "diff",
        "changes",
        "error"
      ],
      "properties": {
        "policy_id": {"enum": ["carla_ego_proxy_v0.1", "metadrive_pg_ego_proxy_v0.1"]},
        "status": {"const": "failed"},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "final_sha256": {"type": "null"},
        "diff": {"type": "null"},
        "changes": {"const": []},
        "error": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
