{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/generation_run_manifest.schema.json",
  "title": "Complete immutable generation run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_type",
    "method_id",
    "platform",
    "library_sha256",
    "roster_sha256",
    "config_sha256",
    "implementation_bundle_sha256",
    "record_count",
    "records",
    "producer",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "manifest_type": {"const": "generation_run_manifest_v0.1"},
    "method_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "library_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "roster_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "run_directory",
          "response_record_sha256",
          "evidence_record_sha256"
        ],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "run_directory": {"type": "string", "minLength": 1},
          "response_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "producer": {
      "type": "object",
      "required": ["producer_id", "producer_version", "created_at_utc"],
      "properties": {
        "producer_id": {"const": "immutable-generation-runner"},
        "producer_version": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
