{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_adjudication_packet.schema.json",
  "title": "Pending adjudication packet without fabricated human conclusions",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "packet_status",
    "source_binding",
    "context",
    "adjudicator_id",
    "annotator_submissions",
    "formal_gold_created",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {
      "enum": [
        "query_oracle_adjudication",
        "protocol_proposal_adjudication",
        "bound_protocol_adjudication",
        "platform_fixture_capability_adjudication",
        "judge_calibration_adjudication"
      ]
    },
    "packet_id": {"$ref": "#/definitions/sha256"},
    "packet_status": {
      "enum": ["blocked_pending_independent_submissions", "pending_adjudication"]
    },
    "source_binding": {"type": "object", "minProperties": 1},
    "context": {"type": "object"},
    "adjudicator_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "annotator_submissions": {
      "type": "object",
      "required": ["annotator_a", "annotator_b"],
      "properties": {
        "annotator_a": {"$ref": "#/definitions/submission_binding"},
        "annotator_b": {"$ref": "#/definitions/submission_binding"}
      },
      "additionalProperties": false
    },
    "formal_gold_created": {"const": false},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "subject_id",
          "subject_sha256",
          "subject",
          "annotator_a_response",
          "annotator_b_response",
          "adjudication_response_template"
        ],
        "properties": {
          "task_id": {"$ref": "#/definitions/sha256"},
          "subject_id": {"type": "string", "minLength": 1},
          "subject_sha256": {"$ref": "#/definitions/sha256"},
          "subject": {"type": "object", "minProperties": 1},
          "annotator_a_response": {
            "oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1}]
          },
          "annotator_b_response": {
            "oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1}]
          },
          "adjudication_response_template": {
            "type": "object",
            "required": ["status", "verdict", "rationale", "final_payload"],
            "properties": {
              "status": {"const": "pending"},
              "verdict": {"type": "null"},
              "rationale": {"const": ""},
              "final_payload": {"type": "null"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "submission_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["reviewer_id", "submission_sha256"],
          "properties": {
            "reviewer_id": {"type": "string", "minLength": 1},
            "submission_sha256": {"$ref": "#/definitions/sha256"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
