{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_adjudication_submission.schema.json",
  "title": "Completed adjudication submission bound to two independent reviews",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "adjudicator_id",
    "source_binding",
    "submission_status",
    "responses"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {
      "enum": [
        "query_oracle_adjudication",
        "bound_protocol_adjudication",
        "platform_fixture_capability_adjudication",
        "judge_calibration_adjudication"
      ]
    },
    "packet_id": {"$ref": "#/definitions/sha256"},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "source_binding": {"type": "object", "minProperties": 1},
    "submission_status": {"const": "complete"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "subject_id",
          "subject_sha256",
          "rationale",
          "final_payload"
        ],
        "properties": {
          "task_id": {"$ref": "#/definitions/sha256"},
          "subject_id": {"type": "string", "minLength": 1},
          "subject_sha256": {"$ref": "#/definitions/sha256"},
          "rationale": {"type": "string", "minLength": 1},
          "final_payload": {"type": "object", "minProperties": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
