{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_bound_review_packet.schema.json",
  "title": "Source-bound single-reviewer human review packet",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "reviewer_id",
    "decision_status",
    "source_binding",
    "tasks",
    "submission_template"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {
      "enum": [
        "platform_fixture_capability_review",
        "judge_calibration_blind_review"
      ]
    },
    "packet_id": {"$ref": "#/definitions/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "decision_status": {"const": "pending"},
    "source_binding": {"type": "object", "minProperties": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/task"}
    },
    "submission_template": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_type",
        "packet_id",
        "reviewer_id",
        "source_binding",
        "review_assignment_policy",
        "submission_status",
        "responses"
      ],
      "properties": {
        "schema_version": {"const": "0.1"},
        "workflow_type": {
          "enum": [
            "platform_fixture_capability_review",
            "judge_calibration_blind_review"
          ]
        },
        "packet_id": {"$ref": "#/definitions/sha256"},
        "reviewer_id": {"type": "string", "minLength": 1},
        "source_binding": {"type": "object", "minProperties": 1},
        "review_assignment_policy": {"const": "single_reviewer_final"},
        "submission_status": {"const": "pending"},
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/pending_response"}
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "subject_id",
        "subject_sha256",
        "subject",
        "response_template"
      ],
      "properties": {
        "task_id": {"$ref": "#/definitions/sha256"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_sha256": {"$ref": "#/definitions/sha256"},
        "subject": {"type": "object", "minProperties": 1},
        "response_template": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "pending_response": {
      "type": "object",
      "required": ["task_id", "subject_id", "subject_sha256", "response"],
      "properties": {
        "task_id": {"$ref": "#/definitions/sha256"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_sha256": {"$ref": "#/definitions/sha256"},
        "response": {"type": "null"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
