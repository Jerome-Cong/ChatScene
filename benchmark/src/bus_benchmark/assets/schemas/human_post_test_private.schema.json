{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_post_test_private.schema.json",
  "title": "Private post-test identity linkage and terminal-status strata",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "public_packet_id",
    "population_sha256",
    "population_hash_scope",
    "selection_algorithm",
    "rate",
    "seed",
    "population_count",
    "selected",
    "method_targets",
    "allocations",
    "links"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "post_test_method_blind_audit"},
    "public_packet_id": {"$ref": "#/definitions/sha256"},
    "population_sha256": {"$ref": "#/definitions/sha256"},
    "population_hash_scope": {"enum": ["file_bytes", "canonical_records"]},
    "selection_algorithm": {"const": "method_stratified_terminal_status_sha256_v0.1"},
    "rate": {"type": "number", "minimum": 0.1, "maximum": 1},
    "seed": {"type": "integer"},
    "population_count": {"type": "integer", "minimum": 1},
    "selected": {"type": "integer", "minimum": 1},
    "method_targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "allocations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blind_review_id",
          "run_id",
          "method_id",
          "query_id",
          "platform",
          "source_record_sha256",
          "public_task_sha256",
          "stratum"
        ],
        "properties": {
          "blind_review_id": {"$ref": "#/definitions/sha256"},
          "run_id": {"type": "string", "minLength": 1},
          "method_id": {"type": "string", "minLength": 1},
          "query_id": {"type": "string", "minLength": 1},
          "platform": {"enum": ["carla", "metadrive"]},
          "source_record_sha256": {"$ref": "#/definitions/sha256"},
          "public_task_sha256": {"$ref": "#/definitions/sha256"},
          "stratum": {
            "type": "object",
            "required": ["platform", "surface_style", "terminal_status", "score_band"],
            "properties": {
              "platform": {"enum": ["carla", "metadrive"]},
              "surface_style": {"enum": ["precise", "partial", "vague"]},
              "terminal_status": {"type": "string", "minLength": 1},
              "score_band": {"enum": ["low", "mid", "high", "unscored"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
