{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_post_test_public.schema.json",
  "title": "Method-blind public post-test audit tasks",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "review_policy",
    "packet_id",
    "selection_algorithm",
    "population_sha256",
    "population_hash_scope",
    "rate",
    "seed",
    "method_blind",
    "review_status",
    "selected",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "post_test_method_blind_audit"},
    "review_policy": {"const": "one_complete_human_gold_per_subject"},
    "packet_id": {"$ref": "#/definitions/sha256"},
    "selection_algorithm": {"const": "method_stratified_terminal_status_sha256_v0.1"},
    "population_sha256": {"$ref": "#/definitions/sha256"},
    "population_hash_scope": {"enum": ["file_bytes", "canonical_records"]},
    "rate": {"type": "number", "minimum": 0.1, "maximum": 1},
    "seed": {"type": "integer"},
    "method_blind": {"const": true},
    "review_status": {"const": "pending"},
    "selected": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blind_review_id",
          "query_id",
          "surface_style",
          "terminal_status",
          "review_payload",
          "response_template"
        ],
        "properties": {
          "blind_review_id": {"$ref": "#/definitions/sha256"},
          "query_id": {"type": "string", "minLength": 1},
          "surface_style": {"enum": ["precise", "partial", "vague"]},
          "terminal_status": {"type": "string", "minLength": 1},
          "review_payload": {"type": "object", "minProperties": 1},
          "response_template": {
            "type": "object",
            "required": [
              "review_status",
              "human_srs",
              "human_arc",
              "human_rsc",
              "human_iec_spec",
              "error_taxonomy",
              "notes"
            ],
            "properties": {
              "review_status": {"const": "pending"},
              "human_srs": {"type": "null"},
              "human_arc": {"type": "null"},
              "human_rsc": {"type": "null"},
              "human_iec_spec": {"type": "null"},
              "error_taxonomy": {"type": "array", "maxItems": 0},
              "notes": {"const": ""}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
