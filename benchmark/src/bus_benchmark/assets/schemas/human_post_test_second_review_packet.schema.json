{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_post_test_second_review_packet.schema.json",
  "title": "Independent method-blind post-test second-review packet",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "source_public_packet_id",
    "first_submission_sha256",
    "method_blind",
    "first_review_response_exposed",
    "review_status",
    "selected",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "post_test_method_blind_second_review"},
    "packet_id": {"$ref": "#/definitions/sha256"},
    "source_public_packet_id": {"$ref": "#/definitions/sha256"},
    "first_submission_sha256": {"$ref": "#/definitions/sha256"},
    "method_blind": {"const": true},
    "first_review_response_exposed": {"const": false},
    "review_status": {"const": "pending"},
    "selected": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blind_review_id",
          "query_id",
          "surface_style",
          "terminal_status",
          "review_payload",
          "response_template"
        ],
        "properties": {
          "blind_review_id": {"$ref": "#/definitions/sha256"},
          "query_id": {"type": "string", "minLength": 1},
          "surface_style": {"enum": ["precise", "partial", "vague"]},
          "terminal_status": {"type": "string", "minLength": 1},
          "review_payload": {"type": "object", "minProperties": 1},
          "response_template": {"type": "object", "minProperties": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
