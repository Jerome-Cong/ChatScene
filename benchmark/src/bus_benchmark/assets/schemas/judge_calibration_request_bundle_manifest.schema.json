{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_calibration_request_bundle_manifest.schema.json",
  "title": "Immutable Judge calibration request bundle",
  "type": "object",
  "required": [
    "schema_version", "result_kind", "calibration_profile",
    "formal_freeze_eligible", "request_count", "request_index_sha256",
    "calibration_context_sha256", "calibration_roster_sha256",
    "calibration_human_gold_sha256", "runner_manifest_sha256", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_kind": {"const": "judge_calibration_request_bundle"},
    "calibration_profile": {"enum": ["carla_stage", "cross_platform_final"]},
    "formal_freeze_eligible": {"type": "boolean"},
    "request_count": {"type": "integer", "minimum": 1},
    "request_index_sha256": {"$ref": "#/definitions/sha256"},
    "calibration_context_sha256": {"$ref": "#/definitions/sha256"},
    "calibration_roster_sha256": {"$ref": "#/definitions/sha256"},
    "calibration_human_gold_sha256": {"$ref": "#/definitions/sha256"},
    "runner_manifest_sha256": {"$ref": "#/definitions/sha256"},
    "manifest_sha256": {"$ref": "#/definitions/sha256"}
  },
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
