{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_output.schema.json",
  "title": "Strict semantic-atom judge output",
  "type": "object",
  "required": ["evidence", "rationale", "verdict", "confidence"],
  "properties": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["satisfied", "violated", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
