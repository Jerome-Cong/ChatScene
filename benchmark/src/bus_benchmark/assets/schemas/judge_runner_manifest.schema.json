{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_runner_manifest.schema.json",
  "title": "Frozen provider-neutral semantic Judge runner",
  "type": "object",
  "required": [
    "schema_version",
    "decision_status",
    "runner_id",
    "runner_version",
    "input_contract",
    "output_contract",
    "execution_order",
    "max_attempts",
    "environment_manifest",
    "source_files",
    "command"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"const": "confirmed"},
    "runner_id": {"type": "string", "minLength": 1},
    "runner_version": {"type": "string", "minLength": 1},
    "input_contract": {"const": "canonical_judge_request_stdin_v0.1"},
    "output_contract": {"const": "judge_output_stdout_v0.1"},
    "execution_order": {"const": "item_id_ascending"},
    "max_attempts": {"const": 1},
    "environment_manifest": {"$ref": "#/definitions/file_binding"},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/file_binding"}
    },
    "command": {
      "type": "object",
      "required": [
        "argv",
        "timeout_seconds",
        "max_request_bytes",
        "max_stdout_bytes",
        "max_stderr_bytes",
        "credential_env_names"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
        "max_request_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "max_stderr_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "credential_env_names": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
