{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/metadrive_native_probe_evidence.schema.json",
  "title": "Source-bound MetaDrive native token and reset-step probe evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "probe_id",
    "platform",
    "status",
    "evidence_mode",
    "claim_scope",
    "bindings",
    "runtime",
    "runtime_fixture",
    "reset_step",
    "token_registry_check"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "artifact_type": {"const": "metadrive_native_probe_evidence_v0.1"},
    "probe_id": {"const": "metadrive_sequence_block_track_probe_v0.1"},
    "platform": {"const": "metadrive"},
    "status": {"const": "passed"},
    "evidence_mode": {"enum": ["development", "formal"]},
    "claim_scope": {
      "type": "object",
      "required": [
        "real_map_used",
        "method_run_evidence",
        "human_gold",
        "token_coverage",
        "validation_level",
        "long_sequence_constructibility_proven",
        "thirty_second_ne_proven",
        "iec_execution_proven"
      ],
      "properties": {
        "real_map_used": {"const": false},
        "method_run_evidence": {"const": false},
        "human_gold": {"const": false},
        "token_coverage": {"const": "single_token_materialization"},
        "validation_level": {"const": "native_pgmap_reset_step"},
        "long_sequence_constructibility_proven": {"const": false},
        "thirty_second_ne_proven": {"const": false},
        "iec_execution_proven": {"const": false}
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "required": [
        "platform_runtime_config",
        "token_registry",
        "runtime_environment_manifest",
        "probe_runner",
        "native_observer"
      ],
      "properties": {
        "platform_runtime_config": {"$ref": "#/definitions/fileBinding"},
        "token_registry": {"$ref": "#/definitions/fileBinding"},
        "runtime_environment_manifest": {"$ref": "#/definitions/fileBinding"},
        "probe_runner": {"$ref": "#/definitions/fileBinding"},
        "native_observer": {"$ref": "#/definitions/fileBinding"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "interpreter",
        "python_runtime_version",
        "locked_dependency_count",
        "locked_dependencies_sha256",
        "environment_decision_status",
        "metadrive_version",
        "metadrive_module",
        "source_tree",
        "source_describe"
      ],
      "properties": {
        "interpreter": {"$ref": "#/definitions/fileBinding"},
        "python_runtime_version": {"type": "string", "minLength": 1},
        "locked_dependency_count": {"type": "integer", "minimum": 1},
        "locked_dependencies_sha256": {"$ref": "#/definitions/sha256"},
        "environment_decision_status": {"enum": ["draft", "frozen"]},
        "metadrive_version": {"type": "string", "minLength": 1},
        "metadrive_module": {"$ref": "#/definitions/fileBinding"},
        "source_tree": {"$ref": "#/definitions/sourceTreeBinding"},
        "source_describe": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtime_fixture": {
      "type": "object",
      "required": ["fixture_status", "artifact_sha256", "artifact_bytes", "artifact"],
      "properties": {
        "fixture_status": {
          "enum": [
            "benchmark_constructed_development_probe",
            "benchmark_constructed_formal_probe"
          ]
        },
        "artifact_sha256": {"$ref": "#/definitions/sha256"},
        "artifact_bytes": {"type": "integer", "minimum": 1},
        "artifact": {"$ref": "#/definitions/runtimeProbeArtifact"}
      },
      "additionalProperties": false
    },
    "reset_step": {
      "type": "object",
      "required": [
        "status",
        "step_action",
        "reset_succeeded",
        "step_succeeded",
        "vehicle_class",
        "vehicle_model",
        "physical_length_m",
        "physical_width_m",
        "physical_height_m",
        "top_down_length_m",
        "top_down_width_m",
        "block_sequence",
        "expected_block_ids",
        "actual_block_ids"
      ],
      "properties": {
        "status": {"const": "passed"},
        "step_action": {"const": [0.0, 0.0]},
        "reset_succeeded": {"const": true},
        "step_succeeded": {"const": true},
        "vehicle_class": {"const": "XLVehicle"},
        "vehicle_model": {"const": "xl"},
        "physical_length_m": {"const": 5.74},
        "physical_width_m": {"const": 2.3},
        "physical_height_m": {"const": 2.8},
        "top_down_length_m": {"const": 5.33},
        "top_down_width_m": {"const": 2.1},
        "block_sequence": {"const": "S"},
        "expected_block_ids": {"const": ["I", "S"]},
        "actual_block_ids": {"const": ["I", "S"]}
      },
      "additionalProperties": false
    },
    "token_registry_check": {
      "type": "object",
      "required": [
        "registry_id",
        "registry_decision_status",
        "token_mapping",
        "lane_num_constraints",
        "positive_cases",
        "expected_native_failures"
      ],
      "properties": {
        "registry_id": {"const": "metadrive-pg-token-registry-v0.1"},
        "registry_decision_status": {"enum": ["draft", "frozen"]},
        "token_mapping": {"$ref": "#/definitions/tokenMapping"},
        "lane_num_constraints": {"$ref": "#/definitions/laneConstraints"},
        "positive_cases": {"$ref": "#/definitions/positiveCases"},
        "expected_native_failures": {"$ref": "#/definitions/negativeCases"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_mode": {"const": "development"}},
        "required": ["evidence_mode"]
      },
      "then": {
        "properties": {
          "runtime_fixture": {
            "properties": {
              "fixture_status": {"const": "benchmark_constructed_development_probe"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"evidence_mode": {"const": "formal"}},
        "required": ["evidence_mode"]
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {"environment_decision_status": {"const": "frozen"}}
          },
          "runtime_fixture": {
            "properties": {
              "fixture_status": {"const": "benchmark_constructed_formal_probe"}
            }
          },
          "token_registry_check": {
            "properties": {"registry_decision_status": {"const": "frozen"}}
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sourceTreeBinding": {
      "type": "object",
      "required": [
        "repository_path",
        "revision",
        "tracked_subpath",
        "tracked_tree_sha256",
        "tracked_file_count",
        "tracked_bytes",
        "policy"
      ],
      "properties": {
        "repository_path": {"type": "string", "minLength": 1},
        "revision": {"const": "85e5dadc6c7436d324348f6e3d8f8e680c06b4db"},
        "tracked_subpath": {"const": "metadrive"},
        "tracked_tree_sha256": {"$ref": "#/definitions/sha256"},
        "tracked_file_count": {"type": "integer", "minimum": 1},
        "tracked_bytes": {"type": "integer", "minimum": 1},
        "policy": {"const": "git_tracked_worktree_bytes_v0.1"}
      },
      "additionalProperties": false
    },
    "runtimeProbeArtifact": {
      "allOf": [
        {"$ref": "metadrive_pg_block_scene.schema.json"},
        {
          "type": "object",
          "properties": {
            "time_step_s": {"const": 0.1},
            "horizon_steps": {"const": 2},
            "map": {
              "properties": {
                "generation_type": {"const": "block_sequence"},
                "block_sequence": {"const": "S"},
                "map_seed": {"const": 0},
                "lane_num": {"const": 2},
                "lane_width_m": {"const": 3.5},
                "exit_length_m": {"const": 50.0},
                "token_registry_id": {"const": "metadrive-pg-token-registry-v0.1"}
              }
            },
            "ego": {
              "properties": {
                "actor_id": {"const": "ego"},
                "actor_type": {"const": "vehicle"},
                "vehicle_model": {"const": "xl"},
                "length_m": {"const": 5.33},
                "width_m": {"const": 2.1}
              }
            },
            "actors": {"maxItems": 0}
          }
        }
      ]
    },
    "tokenMapping": {
      "type": "object",
      "required": ["$", "B", "C", "O", "P", "R", "S", "T", "U", "X", "Y", "r", "y"],
      "properties": {
        "$": {"const": "TollGate"},
        "B": {"const": "Bidirection"},
        "C": {"const": "Curve"},
        "O": {"const": "Roundabout"},
        "P": {"const": "ParkingLot"},
        "R": {"const": "OutRampOnStraight"},
        "S": {"const": "Straight"},
        "T": {"const": "StdTInterSection"},
        "U": {"const": "StdInterSectionWithUTurn"},
        "X": {"const": "StdInterSection"},
        "Y": {"const": "Split"},
        "r": {"const": "InRampOnStraight"},
        "y": {"const": "Merge"}
      },
      "additionalProperties": false
    },
    "laneConstraints": {
      "type": "object",
      "required": ["$", "B", "C", "O", "P", "R", "S", "T", "U", "X", "Y", "r", "y"],
      "properties": {
        "$": {"const": [1, 2, 3, 4, 5]},
        "B": {"const": [1, 2, 3, 4, 5]},
        "C": {"const": [1, 2, 3, 4, 5]},
        "O": {"const": [1, 2, 3, 4, 5]},
        "P": {"const": [1]},
        "R": {"const": [1, 2, 3, 4, 5]},
        "S": {"const": [1, 2, 3, 4, 5]},
        "T": {"const": [1, 2, 3, 4, 5]},
        "U": {"const": [1, 2, 3, 4, 5]},
        "X": {"const": [1, 2, 3, 4, 5]},
        "Y": {"const": [1, 2, 3, 4, 5]},
        "r": {"const": [1, 2, 3, 4, 5]},
        "y": {"const": [1, 2, 3, 4, 5]}
      },
      "additionalProperties": false
    },
    "positiveCase": {
      "type": "object",
      "required": [
        "case_id",
        "token",
        "lane_num",
        "expected_outcome",
        "observed_outcome",
        "expected_block_ids",
        "actual_block_ids",
        "map_feature_count",
        "failure_contract"
      ],
      "properties": {
        "case_id": {"enum": ["$", "B", "C", "O", "P", "R", "S", "T", "U", "X", "Y", "r", "y"]},
        "token": {"enum": ["$", "B", "C", "O", "P", "R", "S", "T", "U", "X", "Y", "r", "y"]},
        "lane_num": {"enum": [1, 2]},
        "expected_outcome": {"const": "materialized"},
        "observed_outcome": {"const": "materialized"},
        "expected_block_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "actual_block_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "map_feature_count": {"type": "integer", "minimum": 1},
        "failure_contract": {"type": "null"}
      },
      "oneOf": [
        {"properties": {"case_id": {"const": "$"}, "token": {"const": "$"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "$"]}, "actual_block_ids": {"const": ["I", "$"]}}},
        {"properties": {"case_id": {"const": "B"}, "token": {"const": "B"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "B"]}, "actual_block_ids": {"const": ["I", "B"]}}},
        {"properties": {"case_id": {"const": "C"}, "token": {"const": "C"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "C"]}, "actual_block_ids": {"const": ["I", "C"]}}},
        {"properties": {"case_id": {"const": "O"}, "token": {"const": "O"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "O"]}, "actual_block_ids": {"const": ["I", "O"]}}},
        {"properties": {"case_id": {"const": "P"}, "token": {"const": "P"}, "lane_num": {"const": 1}, "expected_block_ids": {"const": ["I", "P"]}, "actual_block_ids": {"const": ["I", "P"]}}},
        {"properties": {"case_id": {"const": "R"}, "token": {"const": "R"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "R"]}, "actual_block_ids": {"const": ["I", "R"]}}},
        {"properties": {"case_id": {"const": "S"}, "token": {"const": "S"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "S"]}, "actual_block_ids": {"const": ["I", "S"]}}},
        {"properties": {"case_id": {"const": "T"}, "token": {"const": "T"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "T"]}, "actual_block_ids": {"const": ["I", "T"]}}},
        {"properties": {"case_id": {"const": "U"}, "token": {"const": "U"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "U"]}, "actual_block_ids": {"const": ["I", "U"]}}},
        {"properties": {"case_id": {"const": "X"}, "token": {"const": "X"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "X"]}, "actual_block_ids": {"const": ["I", "X"]}}},
        {"properties": {"case_id": {"const": "Y"}, "token": {"const": "Y"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "Y"]}, "actual_block_ids": {"const": ["I", "Y"]}}},
        {"properties": {"case_id": {"const": "r"}, "token": {"const": "r"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "r"]}, "actual_block_ids": {"const": ["I", "r"]}}},
        {"properties": {"case_id": {"const": "y"}, "token": {"const": "y"}, "lane_num": {"const": 2}, "expected_block_ids": {"const": ["I", "y"]}, "actual_block_ids": {"const": ["I", "y"]}}}
      ],
      "additionalProperties": false
    },
    "positiveCases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/definitions/positiveCase"},
      "allOf": [
        {"contains": {"properties": {"case_id": {"const": "$"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "B"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "C"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "O"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "P"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "R"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "S"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "T"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "U"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "X"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "Y"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "r"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "y"}}, "required": ["case_id"]}}
      ]
    },
    "negativeCase": {
      "type": "object",
      "required": [
        "case_id",
        "token",
        "lane_num",
        "expected_outcome",
        "observed_outcome",
        "expected_block_ids",
        "actual_block_ids",
        "map_feature_count",
        "failure_contract"
      ],
      "properties": {
        "case_id": {"enum": ["F@lane2", "f@lane2", "P@lane2"]},
        "token": {"enum": ["F", "f", "P"]},
        "lane_num": {"const": 2},
        "expected_outcome": {"const": "native_failure"},
        "observed_outcome": {"const": "native_failure"},
        "expected_block_ids": {"type": "null"},
        "actual_block_ids": {"type": "null"},
        "map_feature_count": {"const": 0},
        "failure_contract": {
          "enum": ["known_fork_constructor_failure", "parking_requires_one_lane"]
        }
      },
      "oneOf": [
        {"properties": {"case_id": {"const": "F@lane2"}, "token": {"const": "F"}, "failure_contract": {"const": "known_fork_constructor_failure"}}},
        {"properties": {"case_id": {"const": "f@lane2"}, "token": {"const": "f"}, "failure_contract": {"const": "known_fork_constructor_failure"}}},
        {"properties": {"case_id": {"const": "P@lane2"}, "token": {"const": "P"}, "failure_contract": {"const": "parking_requires_one_lane"}}}
      ],
      "additionalProperties": false
    },
    "negativeCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/definitions/negativeCase"},
      "allOf": [
        {"contains": {"properties": {"case_id": {"const": "F@lane2"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "f@lane2"}}, "required": ["case_id"]}},
        {"contains": {"properties": {"case_id": {"const": "P@lane2"}}, "required": ["case_id"]}}
      ]
    }
  }
}
