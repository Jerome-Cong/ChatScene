{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/metadrive_track_draft_decisions.schema.json",
  "title": "MetaDrive machine decisions crosswalked to existing formal gates",
  "type": "object",
  "required": [
    "schema_version",
    "decision_status",
    "human_gold",
    "platform",
    "track_scope",
    "source_revision",
    "formal_alignment",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"const": "draft"},
    "human_gold": {"const": false},
    "platform": {"const": "metadrive"},
    "track_scope": {"const": "builtin_sequence_block_tokens_only"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "formal_alignment": {
      "type": "object",
      "required": [
        "crosswalk_contract",
        "standalone_human_gold_subject",
        "standalone_human_gold_records_required",
        "decision_items_are_machine_crosswalk_entries",
        "formal_human_gold_created_only_at_destinations",
        "completed_admissible_human_gold_records"
      ],
      "properties": {
        "crosswalk_contract": {"const": "metadrive_machine_decision_to_formal_destination_v0.1"},
        "standalone_human_gold_subject": {"const": false},
        "standalone_human_gold_records_required": {"const": 0},
        "decision_items_are_machine_crosswalk_entries": {"const": true},
        "formal_human_gold_created_only_at_destinations": {"const": true},
        "completed_admissible_human_gold_records": {"const": 0}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "draft_decision",
          "formal_destination",
          "proposal",
          "reason"
        ],
        "properties": {
          "decision_id": {
            "enum": [
              "MD_TOKEN_EXECUTABLE_WHITELIST",
              "MD_EGO_XL_PROXY",
              "MD_QUERY_BLIND_POLICY",
              "MD_SV_REPETITION_SEMANTICS",
              "MD_EVIDENCE_SEPARATION",
              "MD_METHOD_ADAPTER_ADMISSION"
            ]
          },
          "draft_decision": {"type": "string", "minLength": 1},
          "formal_destination": {
            "type": "object",
            "required": [
              "destination_type",
              "destination_id",
              "standalone_human_gold_records_added"
            ],
            "properties": {
              "destination_type": {
                "enum": [
                  "platform_review_subject",
                  "protocol_decision_subject",
                  "automatic_gate"
                ]
              },
              "destination_id": {"type": "string", "minLength": 1},
              "standalone_human_gold_records_added": {"const": 0}
            },
            "additionalProperties": false
          },
          "proposal": {"type": "object", "minProperties": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
