{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/protocol_decision_review.schema.json",
  "title": "Single-reviewer human gold for one-time benchmark protocol decisions",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "review_policy",
    "review_status",
    "decision_status",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "protocol_decision_human_gold_collection"},
    "review_policy": {"const": "one_complete_human_gold_per_subject"},
    "review_status": {"const": "complete"},
    "decision_status": {"const": "confirmed"},
    "decisions": {
      "type": "array",
      "maxItems": 13,
      "items": {"$ref": "#/definitions/decision"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "reason"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {"const": "approve"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "gold_record_id",
        "decision_id",
        "subject",
        "subject_sha256",
        "reviewer",
        "review_status",
        "decision_status"
      ],
      "properties": {
        "gold_record_id": {"$ref": "#/definitions/sha256"},
        "decision_id": {
          "enum": [
            "BENCHMARK_SUITE_VISIBILITY",
            "DEV_TEST_OVERLAP",
            "TEST_DUPLICATE_CLUSTERS",
            "B08_SUPPORTED_REJECTION",
            "ACTOR_CARDINALITY",
            "LANE_TRISTATE",
            "RISK_METADATA",
            "EVENT_ONTOLOGY",
            "CPD_ELIGIBILITY",
            "JUDGE_CALIBRATION_ROSTER",
            "RUNTIME_VALIDATION_CARLA",
            "RUNTIME_VALIDATION_METADRIVE",
            "EGO_PROXY_AND_CONTROLLERS"
          ]
        },
        "subject": {"type": "object", "minProperties": 1},
        "subject_sha256": {"$ref": "#/definitions/sha256"},
        "reviewer": {"$ref": "#/definitions/label"},
        "review_status": {"const": "complete"},
        "decision_status": {"const": "confirmed"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
