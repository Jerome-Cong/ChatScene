{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/cpd_aggregate.schema.json",
  "title": "Provenance-bound CPD common-semantic aggregate",
  "type": "object",
  "required": [
    "schema_version",
    "result_kind",
    "method_id",
    "platform",
    "generation_chain",
    "cpd_common",
    "coverage",
    "precise_stability",
    "queries",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_kind": {"const": "cpd_common_aggregate"},
    "method_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "generation_chain": {
      "type": "object",
      "required": [
        "verified",
        "generation_run_manifest_sha256",
        "implementation_bundle_sha256"
      ],
      "properties": {
        "verified": {"type": "boolean"},
        "generation_run_manifest_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "implementation_bundle_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"}
      },
      "additionalProperties": false
    },
    "cpd_common": {
      "type": "object",
      "required": ["partial", "vague", "joint"],
      "properties": {
        "partial": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/cpd_group"},
        "vague": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/cpd_group"},
        "joint": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/cpd_group"}
      },
      "additionalProperties": false
    },
    "coverage": {"$ref": "cpd_coverage.schema.json"},
    "precise_stability": {
      "type": "object",
      "required": [
        "supported_query_count",
        "scored_query_count",
        "macro_mean_pairwise_distance",
        "pair_count",
        "queries"
      ],
      "properties": {
        "supported_query_count": {"type": "integer", "minimum": 0},
        "scored_query_count": {"type": "integer", "minimum": 0},
        "macro_mean_pairwise_distance": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_score"},
        "pair_count": {"type": "integer", "minimum": 0},
        "queries": {
          "type": "object",
          "additionalProperties": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/stability_query"}
        }
      },
      "additionalProperties": false
    },
    "queries": {
      "type": "object",
      "additionalProperties": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/cpd_query"}
    },
    "provenance": {
      "type": "object",
      "required": [
        "roster_sha256",
        "oracle_sha256",
        "coverage_sha256",
        "semantic_evidence_sha256",
        "semantic_scores_sha256",
        "responses_sha256",
        "judge_responses_sha256",
        "evaluator_source_sha256",
        "freeze_manifest_sha256",
        "generation_chain_verified",
        "generation_run_manifest_sha256",
        "implementation_bundle_sha256",
        "created_at_utc"
      ],
      "properties": {
        "roster_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "oracle_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "coverage_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "semantic_evidence_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "semantic_scores_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "responses_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "judge_responses_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "evaluator_source_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"},
        "freeze_manifest_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "generation_chain_verified": {"type": "boolean"},
        "generation_run_manifest_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "implementation_bundle_sha256": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_sha256"},
        "created_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/sha256"}
      ]
    },
    "optional_score": {
      "oneOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "cpd_group": {
      "type": "object",
      "required": [
        "eligible_query_count",
        "scored_query_count",
        "statistical_cluster_count",
        "macro_mean"
      ],
      "properties": {
        "eligible_query_count": {"type": "integer", "minimum": 0},
        "scored_query_count": {"type": "integer", "minimum": 0},
        "statistical_cluster_count": {"type": "integer", "minimum": 0},
        "macro_mean": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/optional_score"}
      },
      "additionalProperties": false
    },
    "pair_term": {
      "type": "object",
      "required": ["left", "right", "both_core_preserving", "distance", "term"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 4},
        "right": {"type": "integer", "minimum": 0, "maximum": 4},
        "both_core_preserving": {"type": "boolean"},
        "distance": {"type": "number", "minimum": 0, "maximum": 1},
        "term": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "cpd_query": {
      "type": "object",
      "required": [
        "query_id",
        "surface_style",
        "statistical_intent_cluster_id",
        "cpd_common",
        "common_diversity",
        "mean_srs_common",
        "pair_denominator",
        "pair_terms",
        "received_outputs",
        "approved_dimensions",
        "decision_status"
      ],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "surface_style": {"enum": ["partial", "vague"]},
        "statistical_intent_cluster_id": {"type": "string", "minLength": 1},
        "cpd_common": {"type": "number", "minimum": 0, "maximum": 1},
        "common_diversity": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_srs_common": {"type": "number", "minimum": 0, "maximum": 1},
        "pair_denominator": {"const": 10},
        "pair_terms": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "https://chatscene.local/schemas/cpd_aggregate.schema.json#/definitions/pair_term"}
        },
        "received_outputs": {"const": 5},
        "approved_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_status": {"enum": ["draft", "confirmed"]}
      },
      "additionalProperties": false
    },
    "stability_query": {
      "type": "object",
      "required": ["query_id", "mean_pairwise_distance", "pair_count", "received_outputs"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "mean_pairwise_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "pair_count": {"const": 10},
        "received_outputs": {"const": 5}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
