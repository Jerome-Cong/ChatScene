{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/cpd_coverage.schema.json",
  "title": "Frozen CPD common-semantic eligibility coverage",
  "type": "object",
  "required": [
    "eligible",
    "candidate",
    "coverage",
    "by_style",
    "joint",
    "eligible_query_ids",
    "eligible_query_ids_sha256",
    "decision_status"
  ],
  "properties": {
    "eligible": {"type": "integer", "minimum": 0},
    "candidate": {"type": "integer", "minimum": 0},
    "coverage": {"$ref": "#/definitions/optional_score"},
    "by_style": {
      "type": "object",
      "required": ["partial", "vague"],
      "properties": {
        "partial": {"$ref": "#/definitions/coverage_group"},
        "vague": {"$ref": "#/definitions/coverage_group"}
      },
      "additionalProperties": false
    },
    "joint": {"$ref": "#/definitions/coverage_group"},
    "eligible_query_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "eligible_query_ids_sha256": {"$ref": "#/definitions/sha256"},
    "decision_status": {"enum": ["draft", "confirmed"]}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_score": {
      "oneOf": [
        {"type": "null"},
        {"type": "number", "minimum": 0, "maximum": 1}
      ]
    },
    "coverage_group": {
      "type": "object",
      "required": ["eligible", "candidate", "coverage"],
      "properties": {
        "eligible": {"type": "integer", "minimum": 0},
        "candidate": {"type": "integer", "minimum": 0},
        "coverage": {"$ref": "#/definitions/optional_score"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
