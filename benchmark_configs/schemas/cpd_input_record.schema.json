{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/cpd_input_record.schema.json",
  "title": "Per-run CPD common-semantic input record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "method_id",
    "platform",
    "query_id",
    "intent_group_id",
    "statistical_intent_cluster_id",
    "surface_style",
    "repetition",
    "expected_support",
    "terminal_status",
    "common_atoms",
    "srs_common",
    "preservation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "method_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "query_id": {"type": "string", "minLength": 1},
    "intent_group_id": {"type": "string", "minLength": 1},
    "statistical_intent_cluster_id": {"type": "string", "minLength": 1},
    "surface_style": {"enum": ["partial", "vague"]},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 4},
    "expected_support": {"const": "supported"},
    "terminal_status": {"enum": ["complete", "failed", "timeout"]},
    "common_atoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "value"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "value": {},
          "target_signature": {
            "type": "object",
            "required": ["actor_class"],
            "properties": {
              "actor_class": {
                "enum": ["ego_bus", "motor_vehicle", "cyclist", "pedestrian"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "srs_common": {"type": "number", "minimum": 0, "maximum": 1},
    "preservation": {
      "type": "object",
      "required": [
        "ego_gate_passed",
        "all_common_core_satisfied",
        "no_common_forbidden",
        "evidence_complete"
      ],
      "properties": {
        "ego_gate_passed": {"type": "boolean"},
        "all_common_core_satisfied": {"type": "boolean"},
        "no_common_forbidden": {"type": "boolean"},
        "evidence_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "semantic_score_sha256",
        "cpd_policy_sha256",
        "evidence_record_sha256",
        "extractor_manifest_sha256",
        "extractor_id",
        "extractor_version",
        "created_at_utc"
      ],
      "properties": {
        "semantic_score_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cpd_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extractor_manifest_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "extractor_id": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string", "minLength": 1},
        "created_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
