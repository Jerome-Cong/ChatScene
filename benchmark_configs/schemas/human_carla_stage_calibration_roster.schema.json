{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_carla_stage_calibration_roster.schema.json",
  "title": "Non-formal 90-item CARLA-first Judge calibration roster",
  "type": "object",
  "required": [
    "schema_version",
    "decision_status",
    "stage_scope",
    "platform",
    "formal_freeze_eligible",
    "selection_algorithm",
    "seed",
    "eligible_population_count",
    "eligible_population_sha256",
    "items_sha256",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"enum": ["draft", "stage_confirmed"]},
    "stage_scope": {"const": "carla_first"},
    "platform": {"const": "carla"},
    "formal_freeze_eligible": {"const": false},
    "selection_algorithm": {"const": "query_category_then_sha256_v0.1"},
    "seed": {"const": "bus-judge-calibration-v0.1"},
    "eligible_population_count": {"type": "integer", "minimum": 90},
    "eligible_population_sha256": {"$ref": "#/definitions/sha256"},
    "items_sha256": {"$ref": "#/definitions/sha256"},
    "items": {
      "type": "array",
      "minItems": 90,
      "maxItems": 90,
      "items": {"$ref": "#/definitions/item"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "platform",
        "source_id",
        "query_id",
        "run_id",
        "repetition",
        "atom_id",
        "category",
        "surface_style",
        "source_response_sha256",
        "source_evidence_sha256"
      ],
      "properties": {
        "item_id": {"$ref": "#/definitions/sha256"},
        "platform": {"const": "carla"},
        "source_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "repetition": {"type": "integer", "minimum": 0, "maximum": 4},
        "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "category": {"enum": ["actor", "road", "spatial", "event", "temporal", "normative"]},
        "surface_style": {"enum": ["precise", "partial", "vague"]},
        "source_response_sha256": {"$ref": "#/definitions/sha256"},
        "source_evidence_sha256": {"$ref": "#/definitions/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
