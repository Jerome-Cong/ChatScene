{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_carla_stage_platform_report.schema.json",
  "title": "Finalized CARLA-first platform review stage",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "stage_scope",
    "included_platforms",
    "deferred_platforms",
    "formal_freeze_eligible",
    "decision_status",
    "review_policy",
    "canonical_bundle_revalidated",
    "source_binding",
    "human_gold_records"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "carla_stage_platform_review_finalized"},
    "stage_scope": {"const": "carla_first"},
    "included_platforms": {"const": ["carla"]},
    "deferred_platforms": {"const": ["metadrive"]},
    "formal_freeze_eligible": {"const": false},
    "decision_status": {"const": "stage_confirmed"},
    "review_policy": {"const": "one_complete_human_gold_per_subject"},
    "canonical_bundle_revalidated": {"const": true},
    "source_binding": {"type": "object", "minProperties": 1},
    "human_gold_records": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "minProperties": 1}
    }
  },
  "additionalProperties": false
}
