{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_post_test_submission.schema.json",
  "title": "Completed method-blind post-test audit submission",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "public_packet_id",
    "reviewer_id",
    "review_assignment_policy",
    "submission_status",
    "responses"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "post_test_method_blind_audit"},
    "public_packet_id": {"$ref": "#/definitions/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "review_assignment_policy": {"const": "single_reviewer_final"},
    "submission_status": {"const": "complete"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blind_review_id",
          "review_status",
          "human_srs",
          "human_arc",
          "human_rsc",
          "human_iec_spec",
          "error_taxonomy",
          "notes"
        ],
        "properties": {
          "blind_review_id": {"$ref": "#/definitions/sha256"},
          "review_status": {"enum": ["complete", "uncertain"]},
          "human_srs": {"$ref": "#/definitions/score"},
          "human_arc": {"$ref": "#/definitions/score"},
          "human_rsc": {"$ref": "#/definitions/score"},
          "human_iec_spec": {"$ref": "#/definitions/score"},
          "error_taxonomy": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
