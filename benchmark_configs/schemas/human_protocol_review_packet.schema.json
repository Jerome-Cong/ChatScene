{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_protocol_review_packet.schema.json",
  "title": "Independent review packet for 13 unbound protocol proposals",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "annotator_role",
    "reviewer_id",
    "decision_status",
    "source_binding",
    "asset_binding_status",
    "formal_freeze_eligible",
    "tasks",
    "submission_template"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "protocol_proposal_review"},
    "packet_id": {"$ref": "#/definitions/sha256"},
    "annotator_role": {"enum": ["annotator_a", "annotator_b"]},
    "reviewer_id": {"type": "string", "minLength": 1},
    "decision_status": {"const": "draft"},
    "source_binding": {"$ref": "#/definitions/source_binding"},
    "asset_binding_status": {"const": "unbound_draft"},
    "formal_freeze_eligible": {"const": false},
    "tasks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/definitions/task"}
    },
    "submission_template": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_type",
        "packet_id",
        "annotator_role",
        "reviewer_id",
        "source_binding",
        "independent_without_peer_submission",
        "submission_status",
        "responses"
      ],
      "properties": {
        "schema_version": {"const": "0.1"},
        "workflow_type": {"const": "protocol_proposal_review"},
        "packet_id": {"$ref": "#/definitions/sha256"},
        "annotator_role": {"enum": ["annotator_a", "annotator_b"]},
        "reviewer_id": {"type": "string", "minLength": 1},
        "source_binding": {"$ref": "#/definitions/source_binding"},
        "independent_without_peer_submission": {"const": true},
        "submission_status": {"const": "pending"},
        "responses": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": ["task_id", "subject_id", "subject_sha256", "response"],
            "properties": {
              "task_id": {"$ref": "#/definitions/sha256"},
              "subject_id": {"type": "string", "minLength": 1},
              "subject_sha256": {"$ref": "#/definitions/sha256"},
              "response": {"type": "null"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding": {
      "type": "object",
      "required": [
        "protocol_draft_sha256",
        "protocol_hash_scope",
        "decision_count",
        "asset_binding_status"
      ],
      "properties": {
        "protocol_draft_sha256": {"$ref": "#/definitions/sha256"},
        "protocol_hash_scope": {"enum": ["file_bytes", "canonical_object"]},
        "decision_count": {"const": 13},
        "asset_binding_status": {"const": "unbound_draft"}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "subject_id",
        "subject_sha256",
        "machine_proposal",
        "asset_binding_status",
        "formal_freeze_eligible",
        "response_template"
      ],
      "properties": {
        "task_id": {"$ref": "#/definitions/sha256"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_sha256": {"$ref": "#/definitions/sha256"},
        "machine_proposal": {"type": "object", "minProperties": 1},
        "asset_binding_status": {"const": "unbound_draft"},
        "formal_freeze_eligible": {"const": false},
        "response_template": {
          "type": "object",
          "required": ["verdict", "reason", "proposed_revision"],
          "properties": {
            "verdict": {"type": "null"},
            "reason": {"const": ""},
            "proposed_revision": {"type": "null"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
