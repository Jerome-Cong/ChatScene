{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/human_query_review_submission.schema.json",
  "title": "Completed single-reviewer query-oracle submission",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "packet_id",
    "reviewer_id",
    "source_binding",
    "review_assignment_policy",
    "submission_status",
    "responses"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "query_oracle_review"},
    "packet_id": {"$ref": "#/definitions/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "source_binding": {"type": "object", "minProperties": 1},
    "review_assignment_policy": {"const": "single_reviewer_final"},
    "submission_status": {"const": "complete"},
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/task_response"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object",
      "required": ["verdict", "reason"],
      "properties": {
        "verdict": {"enum": ["accept", "revise", "reject"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "atom_decision": {
      "type": "object",
      "required": ["atom_id", "verdict", "reason", "replacement_atoms"],
      "properties": {
        "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "verdict": {"enum": ["accept", "reject", "modify", "split", "merge"]},
        "reason": {"type": "string", "minLength": 1},
        "replacement_atoms": {
          "type": "array",
          "items": {"type": "object", "minProperties": 1}
        }
      },
      "additionalProperties": false
    },
    "cpd_decision": {
      "type": "object",
      "required": ["verdict", "reason", "replacement_policy"],
      "properties": {
        "verdict": {"enum": ["accept", "revise", "reject"]},
        "reason": {"type": "string", "minLength": 1},
        "replacement_policy": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "minProperties": 1}
          ]
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "required_check_decisions",
        "atom_decisions",
        "cpd_decision",
        "proposed_oracle",
        "notes"
      ],
      "properties": {
        "required_check_decisions": {
          "type": "object",
          "required": [
            "support_and_response_disposition",
            "cardinality_and_polarity",
            "road_and_spatial_decomposition",
            "event_graph_and_actor_binding",
            "surface_layering",
            "cpd_common_eligibility"
          ],
          "properties": {
            "support_and_response_disposition": {"$ref": "#/definitions/decision"},
            "cardinality_and_polarity": {"$ref": "#/definitions/decision"},
            "road_and_spatial_decomposition": {"$ref": "#/definitions/decision"},
            "event_graph_and_actor_binding": {"$ref": "#/definitions/decision"},
            "surface_layering": {"$ref": "#/definitions/decision"},
            "cpd_common_eligibility": {"$ref": "#/definitions/decision"}
          },
          "additionalProperties": false
        },
        "atom_decisions": {
          "type": "array",
          "items": {"$ref": "#/definitions/atom_decision"}
        },
        "cpd_decision": {"$ref": "#/definitions/cpd_decision"},
        "proposed_oracle": {"type": "object", "minProperties": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "task_response": {
      "type": "object",
      "required": ["task_id", "subject_id", "subject_sha256", "response"],
      "properties": {
        "task_id": {"$ref": "#/definitions/sha256"},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_sha256": {"$ref": "#/definitions/sha256"},
        "response": {"$ref": "#/definitions/response"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
