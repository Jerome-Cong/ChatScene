{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_calibration.schema.json",
  "title": "Single-reviewer Judge-calibration human gold bound to frozen records",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "gold_record_id",
    "item_id",
    "platform",
    "source_id",
    "query_id",
    "run_id",
    "repetition",
    "atom_id",
    "category",
    "surface_style",
    "source_response_sha256",
    "source_evidence_sha256",
    "reviewer_id",
    "gold_verdict",
    "gold_evidence",
    "gold_rationale",
    "review_status",
    "canonical_source_revalidated",
    "reviewer_blind_to_judge_prediction",
    "decision_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "judge_calibration_human_gold"},
    "gold_record_id": {"$ref": "#/definitions/sha256"},
    "item_id": {"$ref": "#/definitions/sha256"},
    "platform": {"enum": ["carla", "metadrive"]},
    "source_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "repetition": {"type": "integer", "minimum": 0, "maximum": 4},
    "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "category": {"enum": ["actor", "road", "spatial", "event", "temporal", "normative"]},
    "surface_style": {"enum": ["precise", "partial", "vague"]},
    "source_response_sha256": {"$ref": "#/definitions/sha256"},
    "source_evidence_sha256": {"$ref": "#/definitions/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "gold_verdict": {"enum": ["satisfied", "violated", "unknown"]},
    "gold_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "gold_rationale": {"type": "string", "minLength": 1},
    "review_status": {"const": "complete"},
    "canonical_source_revalidated": {"const": true},
    "reviewer_blind_to_judge_prediction": {"const": true},
    "decision_status": {"const": "confirmed"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
