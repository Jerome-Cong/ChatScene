{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_execution_record.schema.json",
  "title": "Immutable provider-neutral semantic Judge execution",
  "type": "object",
  "required": [
    "schema_version", "execution_id", "item_id", "query_id", "run_id", "atom_id",
    "judge_request_sha256", "request_record_sha256", "attempt", "runner_id",
    "runner_version", "runner_manifest_sha256", "terminal_status", "exit_code",
    "timed_out", "raw_judge_request", "stdout", "stderr",
    "process_envelope_sha256", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "execution_id": {"$ref": "#/definitions/sha256"},
    "item_id": {"$ref": "#/definitions/sha256"},
    "query_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "judge_request_sha256": {"$ref": "#/definitions/sha256"},
    "request_record_sha256": {"$ref": "#/definitions/sha256"},
    "attempt": {"const": 0},
    "runner_id": {"type": "string", "minLength": 1},
    "runner_version": {"type": "string", "minLength": 1},
    "runner_manifest_sha256": {"$ref": "#/definitions/sha256"},
    "terminal_status": {"enum": ["complete", "failed", "timeout"]},
    "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
    "timed_out": {"type": "boolean"},
    "raw_judge_request": {"$ref": "#/definitions/file_binding_nonempty"},
    "stdout": {"$ref": "#/definitions/file_binding"},
    "stderr": {"$ref": "#/definitions/file_binding"},
    "process_envelope_sha256": {"$ref": "#/definitions/sha256"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_status": {"const": "complete"}}, "required": ["terminal_status"]},
      "then": {
        "properties": {
          "exit_code": {"const": 0},
          "timed_out": {"const": false},
          "stdout": {"$ref": "#/definitions/file_binding_nonempty"}
        }
      }
    },
    {
      "if": {"properties": {"terminal_status": {"const": "timeout"}}, "required": ["terminal_status"]},
      "then": {"properties": {"timed_out": {"const": true}}}
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "file_binding_nonempty": {
      "allOf": [
        {"$ref": "#/definitions/file_binding"},
        {"properties": {"bytes": {"minimum": 1}}}
      ]
    }
  }
}
