{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_run_manifest.schema.json",
  "title": "Immutable semantic Judge run manifest",
  "type": "object",
  "required": [
    "schema_version", "result_kind", "terminal_status", "request_count",
    "execution_count", "response_count", "request_manifest_sha256",
    "request_manifest",
    "runner_manifest_sha256", "execution_index_sha256",
    "judge_responses_sha256", "created_at_utc", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_kind": {"const": "judge_run_bundle"},
    "terminal_status": {"enum": ["complete", "failed"]},
    "request_count": {"type": "integer", "minimum": 0},
    "execution_count": {"type": "integer", "minimum": 0},
    "response_count": {"type": "integer", "minimum": 0},
    "request_manifest_sha256": {"$ref": "#/definitions/sha256"},
    "request_manifest": {"$ref": "#/definitions/file_binding"},
    "runner_manifest_sha256": {"$ref": "#/definitions/sha256"},
    "execution_index_sha256": {"$ref": "#/definitions/sha256"},
    "judge_responses_sha256": {"$ref": "#/definitions/sha256"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"$ref": "#/definitions/sha256"}
  },
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
