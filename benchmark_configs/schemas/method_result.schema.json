{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/method_result.schema.json",
  "title": "Tamper-evident formal result for one frozen method/platform cell",
  "type": "object",
  "required": [
    "schema_version",
    "result_kind",
    "cell_id",
    "method_id",
    "platform",
    "cell_scope",
    "primary_metrics",
    "diagnostics",
    "provenance",
    "inputs",
    "created_at_utc",
    "result_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "result_kind": {"const": "formal_method_platform_result"},
    "cell_id": {"$ref": "#/definitions/sha256"},
    "method_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "cell_scope": {
      "type": "object",
      "required": [
        "unit",
        "cross_platform_completion_required",
        "missing_cell_policy",
        "platform_effect_adjustment"
      ],
      "properties": {
        "unit": {"const": "method_platform"},
        "cross_platform_completion_required": {"const": false},
        "missing_cell_policy": {"const": "omit_not_zero_or_impute"},
        "platform_effect_adjustment": {"const": "none"}
      },
      "additionalProperties": false
    },
    "primary_metrics": {
      "type": "object",
      "required": [
        "srs",
        "arc",
        "rsc",
        "iec_spec",
        "rqs",
        "uqh",
        "cpd_common",
        "coverage",
        "sv",
        "ne"
      ],
      "properties": {
        "srs": {"$ref": "#/definitions/score"},
        "arc": {"$ref": "#/definitions/score"},
        "rsc": {"$ref": "#/definitions/score"},
        "iec_spec": {"$ref": "#/definitions/score"},
        "rqs": {"$ref": "#/definitions/score"},
        "uqh": {"$ref": "#/definitions/score"},
        "cpd_common": {"$ref": "#/definitions/score"},
        "coverage": {"$ref": "#/definitions/score"},
        "sv": {"$ref": "#/definitions/score"},
        "ne": {"$ref": "#/definitions/score"}
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "semantic_availability",
        "rqs_mean",
        "rqs_vague_gap",
        "cpd_common_partial",
        "cpd_common_vague",
        "compile_success",
        "iec_exec"
      ],
      "properties": {
        "semantic_availability": {
          "type": "object",
          "required": ["arc", "rsc", "iec_spec"],
          "properties": {
            "arc": {"$ref": "#/definitions/availability"},
            "rsc": {"$ref": "#/definitions/availability"},
            "iec_spec": {"$ref": "#/definitions/availability"}
          },
          "additionalProperties": false
        },
        "rqs_mean": {"$ref": "#/definitions/score"},
        "rqs_vague_gap": {"type": "number", "minimum": -1, "maximum": 1},
        "cpd_common_partial": {"$ref": "#/definitions/score"},
        "cpd_common_vague": {"$ref": "#/definitions/score"},
        "compile_success": {"$ref": "#/definitions/score"},
        "iec_exec": {
          "type": "object",
          "required": [
            "status",
            "coverage",
            "available_outputs",
            "trace_outputs",
            "eligible_outputs",
            "reason"
          ],
          "properties": {
            "status": {"const": "unavailable"},
            "coverage": {"const": "none"},
            "available_outputs": {"const": 0},
            "trace_outputs": {"type": "integer", "minimum": 0},
            "eligible_outputs": {"type": "integer", "minimum": 1},
            "reason": {"const": "frozen_query_blind_event_observer_not_registered"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "freeze_manifest_self_sha256",
        "method_config_asset_file_sha256",
        "roster_asset_file_sha256",
        "generation_run_manifest_self_sha256",
        "implementation_bundle_sha256",
        "judge_run_manifest_self_sha256",
        "judge_responses_file_sha256",
        "evaluator_source_bundle_sha256",
        "input_set_sha256",
        "input_closure_sha256",
        "input_closure_file_count",
        "input_closure_directory_count"
      ],
      "properties": {
        "freeze_manifest_self_sha256": {"$ref": "#/definitions/sha256"},
        "method_config_asset_file_sha256": {"$ref": "#/definitions/sha256"},
        "roster_asset_file_sha256": {"$ref": "#/definitions/sha256"},
        "generation_run_manifest_self_sha256": {"$ref": "#/definitions/sha256"},
        "implementation_bundle_sha256": {"$ref": "#/definitions/sha256"},
        "judge_run_manifest_self_sha256": {"$ref": "#/definitions/sha256"},
        "judge_responses_file_sha256": {"$ref": "#/definitions/sha256"},
        "evaluator_source_bundle_sha256": {"$ref": "#/definitions/sha256"},
        "input_set_sha256": {"$ref": "#/definitions/sha256"},
        "input_closure_sha256": {"$ref": "#/definitions/sha256"},
        "input_closure_file_count": {"type": "integer", "minimum": 23},
        "input_closure_directory_count": {"type": "integer", "minimum": 3}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/file_binding"}
    },
    "created_at_utc": {"type": "string", "format": "date-time"},
    "result_sha256": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "file_binding": {
      "type": "object",
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {
          "enum": [
            "controller_config",
            "cpd_aggregate",
            "cpd_coverage",
            "freeze_manifest",
            "generation_evidence_index",
            "generation_responses",
            "generation_run_manifest",
            "judge_execution_index",
            "judge_request_manifest",
            "judge_responses",
            "judge_run_manifest",
            "method_config",
            "platform_config",
            "query_library_test",
            "query_roster",
            "requirement_oracle_test",
            "runtime_aggregate",
            "runtime_records",
            "semantic_aggregate",
            "semantic_evidence",
            "semantic_scores",
            "uqh_assessments",
            "uqh_assessor_registry"
          ]
        },
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "availability",
        "available_output_count",
        "output_count",
        "coverage"
      ],
      "properties": {
        "availability": {"const": "available"},
        "available_output_count": {"type": "integer", "minimum": 1},
        "output_count": {"type": "integer", "minimum": 1},
        "coverage": {"const": 1.0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
