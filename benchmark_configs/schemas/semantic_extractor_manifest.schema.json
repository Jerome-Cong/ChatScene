{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/semantic_extractor_manifest.schema.json",
  "title": "Frozen semantic extractor implementation manifest",
  "type": "object",
  "required": [
    "decision_status",
    "extractor_id",
    "extractor_version",
    "input_contract",
    "output_contract",
    "deterministic_fixture_accuracy",
    "cross_platform_equivalence_passed",
    "runtime_environments",
    "extractor_files",
    "entrypoints",
    "metric_files",
    "schema_files",
    "deterministic_fixture_results",
    "cross_platform_equivalence_results"
  ],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "extractor_id": {"type": "string", "minLength": 1},
    "extractor_version": {"type": "string", "minLength": 1},
    "input_contract": {"const": "artifact_observation_v0.1"},
    "output_contract": {"const": "semantic_projection_v0.1"},
    "deterministic_fixture_accuracy": {"const": 1.0},
    "cross_platform_equivalence_passed": {"const": true},
    "runtime_environments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "validation_level",
          "interpreter",
          "python_version",
          "distributions",
          "source",
          "runtime_probe"
        ],
        "properties": {
          "platform": {"enum": ["carla", "metadrive"]},
          "validation_level": {
            "enum": ["native_compile_and_five_seed_static_sv", "native_pgmap_reset_step"]
          },
          "interpreter": {"$ref": "#/definitions/file_binding"},
          "python_version": {"type": "string", "minLength": 1},
          "distributions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "source": {
            "type": "object",
            "required": [
              "repository_path",
              "revision",
              "tracked_subpath",
              "tracked_tree_sha256"
            ],
            "properties": {
              "repository_path": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "tracked_subpath": {"type": "string", "minLength": 1},
              "tracked_tree_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "runtime_probe": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["observer", "input", "result"],
                "properties": {
                  "observer": {"$ref": "#/definitions/file_binding"},
                  "input": {"$ref": "#/definitions/file_binding"},
                  "result": {"$ref": "#/definitions/file_binding"}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "extractor_files": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/definitions/file_binding"}
    },
    "entrypoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["platform", "path", "sha256", "callable"],
        "properties": {
          "platform": {"enum": ["carla", "metadrive"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "callable": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metric_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/file_binding"}
    },
    "schema_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/file_binding"}
    },
    "deterministic_fixture_results": {"$ref": "#/definitions/file_binding"},
    "cross_platform_equivalence_results": {"$ref": "#/definitions/file_binding"}
  },
  "definitions": {
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
