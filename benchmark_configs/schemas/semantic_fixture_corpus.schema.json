{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/semantic_fixture_corpus.schema.json",
  "title": "Deterministic platform semantic fixture corpus",
  "type": "object",
  "required": ["decision_status", "benchmark_owned", "input_contract", "cases"],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "benchmark_owned": {"const": true},
    "input_contract": {"const": "raw_platform_artifact_v0.1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "platform", "concept_ids", "test_kind", "input", "expected"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "platform": {"enum": ["carla", "metadrive"]},
          "concept_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "test_kind": {
            "enum": [
              "positive",
              "negative",
              "judge_required_positive",
              "judge_required_negative",
              "ego_approved",
              "ego_missing",
              "ego_wrong_proxy",
              "ego_wrong_footprint"
            ]
          },
          "input": {"$ref": "semantic_fixture_input.schema.json"},
          "expected": {"$ref": "semantic_projection.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
