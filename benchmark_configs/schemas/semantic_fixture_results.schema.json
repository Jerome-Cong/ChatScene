{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/semantic_fixture_results.schema.json",
  "title": "Stored semantic fixture outputs",
  "type": "object",
  "required": ["decision_status", "cases"],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["case_id", "actual"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "actual": {"$ref": "semantic_projection.schema.json"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["case_id", "actual_left", "actual_right"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "actual_left": {"$ref": "semantic_projection.schema.json"},
              "actual_right": {"$ref": "semantic_projection.schema.json"}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
