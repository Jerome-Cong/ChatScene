{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/uqh_assessor_registry.schema.json",
  "title": "Frozen independent UQH assessor registry",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "protocol_version",
    "assessment_binding_contract",
    "controlled_degradation_credit",
    "assessors"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["draft", "frozen"]},
    "protocol_version": {"const": "0.1"},
    "assessment_binding_contract": {"const": "uqh_assessment_binding_v0.1"},
    "controlled_degradation_credit": {"const": false},
    "assessors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assessor_id",
          "assessor_version",
          "assessment_source",
          "independent_from_producer_ids",
          "assessment_config",
          "assessor_source",
          "attestation_algorithm",
          "attestation_public_key",
          "key_custody"
        ],
        "properties": {
          "assessor_id": {"type": "string", "minLength": 1},
          "assessor_version": {"type": "string", "minLength": 1},
          "assessment_source": {"enum": ["judge", "human_audit"]},
          "independent_from_producer_ids": {
            "const": ["immutable-generation-runner"]
          },
          "assessment_config": {"$ref": "#/definitions/file_binding"},
          "assessor_source": {"$ref": "#/definitions/file_binding"},
          "attestation_algorithm": {"const": "rsa_pss_sha256"},
          "attestation_public_key": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/definitions/file_binding"}
            ]
          },
          "key_custody": {"const": "external_to_method_runner"}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
