{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/common_ontology.schema.json",
  "title": "Platform-neutral benchmark ontology",
  "type": "object",
  "required": ["schema_version", "decision_status", "ontology_id", "concepts"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"const": "confirmed"},
    "ontology_id": {"type": "string", "minLength": 1},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concept_id", "kind", "definition", "definition_sha256"],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["ego_proxy", "requirement_atom_domain", "cpd_dimension"]},
          "definition": {"type": "object", "minProperties": 1},
          "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
