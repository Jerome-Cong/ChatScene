{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/cross_platform_fixture_corpus.schema.json",
  "title": "Cross-platform semantic equivalence fixture corpus",
  "type": "object",
  "required": ["decision_status", "benchmark_owned", "input_contract", "cases"],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "benchmark_owned": {"const": true},
    "input_contract": {"const": "raw_platform_artifact_v0.1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "concept_id",
          "semantic_category",
          "changed_concept_ids",
          "expected_equal",
          "left_platform",
          "right_platform",
          "left_input",
          "right_input",
          "expected_left",
          "expected_right"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "concept_id": {"type": "string", "minLength": 1},
          "semantic_category": {"enum": ["actor", "road", "spatial", "event", "temporal", "normative", "cpd"]},
          "changed_concept_ids": {
            "type": "array",
            "maxItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "expected_equal": {"type": "boolean"},
          "left_platform": {"const": "carla"},
          "right_platform": {"const": "metadrive"},
          "left_input": {"$ref": "semantic_fixture_input.schema.json"},
          "right_input": {"$ref": "semantic_fixture_input.schema.json"},
          "expected_left": {"$ref": "semantic_projection.schema.json"},
          "expected_right": {"$ref": "semantic_projection.schema.json"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
