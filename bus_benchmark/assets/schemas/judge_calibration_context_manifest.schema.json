{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_calibration_context_manifest.schema.json",
  "title": "Pre-run Judge calibration context",
  "type": "object",
  "required": [
    "schema_version", "decision_status", "context_kind", "calibration_profile",
    "formal_freeze_eligible", "model_id",
    "inference_config", "request_contract", "judge_config_sha256",
    "query_library_dev", "requirement_oracle_dev", "calibration_roster",
    "calibration_human_gold", "prompt", "output_schema", "runner_manifest",
    "development_sources", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"const": "confirmed"},
    "context_kind": {"const": "judge_calibration_pre_run_context"},
    "calibration_profile": {"enum": ["carla_stage", "cross_platform_final"]},
    "formal_freeze_eligible": {"type": "boolean"},
    "model_id": {"type": "string", "minLength": 1},
    "inference_config": {"type": "object"},
    "request_contract": {"const": "judge_atom_v0.1"},
    "judge_config_sha256": {"$ref": "#/definitions/sha256"},
    "query_library_dev": {"$ref": "#/definitions/file_binding"},
    "requirement_oracle_dev": {"$ref": "#/definitions/file_binding"},
    "calibration_roster": {"$ref": "#/definitions/file_binding"},
    "calibration_human_gold": {"$ref": "#/definitions/file_binding"},
    "prompt": {"$ref": "#/definitions/file_binding"},
    "output_schema": {"$ref": "#/definitions/file_binding"},
    "runner_manifest": {"$ref": "#/definitions/file_binding"},
    "development_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "platform", "source_config", "query_roster", "response_records",
          "evidence_records"
        ],
        "properties": {
          "platform": {"enum": ["carla", "metadrive"]},
          "source_config": {"$ref": "#/definitions/file_binding"},
          "query_roster": {"$ref": "#/definitions/file_binding"},
          "response_records": {"$ref": "#/definitions/file_binding"},
          "evidence_records": {"$ref": "#/definitions/file_binding"}
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {"$ref": "#/definitions/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"calibration_profile": {"const": "carla_stage"}},
        "required": ["calibration_profile"]
      },
      "then": {
        "properties": {
          "formal_freeze_eligible": {"const": false},
          "development_sources": {"minItems": 1, "maxItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"calibration_profile": {"const": "cross_platform_final"}},
        "required": ["calibration_profile"]
      },
      "then": {
        "properties": {
          "formal_freeze_eligible": {"const": true},
          "development_sources": {"minItems": 2, "maxItems": 2}
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
