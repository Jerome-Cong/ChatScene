{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_calibration_source_config.schema.json",
  "title": "Benchmark-owned development calibration source",
  "type": "object",
  "required": [
    "decision_status",
    "source_id",
    "platform",
    "reference_corpus",
    "method_independent",
    "query_input_fields",
    "post_output_semantic_repair",
    "implementation_bundle"
  ],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "source_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive"]},
    "reference_corpus": {"const": true},
    "method_independent": {"const": true},
    "query_input_fields": {"const": ["query_text"]},
    "post_output_semantic_repair": {"const": false},
    "implementation_bundle": {"$ref": "#/definitions/file_binding"}
  },
  "additionalProperties": false,
  "definitions": {
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
