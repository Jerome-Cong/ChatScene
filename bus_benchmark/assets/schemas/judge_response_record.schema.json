{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_response_record.schema.json",
  "title": "Immutable raw semantic-atom judge response",
  "type": "object",
  "required": [
    "schema_version",
    "judge_response_id",
    "item_id",
    "query_id",
    "run_id",
    "atom_id",
    "attempt",
    "model_id",
    "judge_config_sha256",
    "judge_request_sha256",
    "terminal_status",
    "raw_response",
    "raw_response_sha256",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "judge_response_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "atom_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "attempt": {"const": 0},
    "model_id": {"type": "string", "minLength": 1},
    "judge_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judge_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_status": {"const": "complete"},
    "raw_response": {"type": "string", "minLength": 1},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "required": ["runner_id", "runner_version", "created_at_utc"],
      "properties": {
        "runner_id": {"type": "string", "minLength": 1},
        "runner_version": {"type": "string", "minLength": 1},
        "runner_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "process_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_request_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "provider_response_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "created_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
