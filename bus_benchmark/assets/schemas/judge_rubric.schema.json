{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/judge_rubric.schema.json",
  "title": "Frozen semantic judge rubric and platform-stratified calibration",
  "type": "object",
  "required": [
    "decision_status",
    "request_contract",
    "model_id",
    "inference_config",
    "prompt",
    "output_schema",
    "runner_manifest_sha256",
    "judge_config_sha256",
    "calibration",
    "calibration_roster",
    "calibration_context",
    "calibration_request_manifest",
    "calibration_run_manifest",
    "calibration_record_count",
    "macro_f1",
    "cohen_kappa",
    "gold_support_by_verdict",
    "platform_metrics"
  ],
  "properties": {
    "decision_status": {"const": "confirmed"},
    "request_contract": {"const": "judge_atom_v0.1"},
    "model_id": {"type": "string", "minLength": 1},
    "inference_config": {"type": "object"},
    "prompt": {"$ref": "#/definitions/file_binding"},
    "output_schema": {"$ref": "#/definitions/file_binding"},
    "runner_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judge_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration": {"$ref": "#/definitions/file_binding"},
    "calibration_roster": {"$ref": "#/definitions/file_binding"},
    "calibration_context": {"$ref": "#/definitions/file_binding"},
    "calibration_request_manifest": {"$ref": "#/definitions/file_binding"},
    "calibration_run_manifest": {"$ref": "#/definitions/file_binding"},
    "calibration_record_count": {"const": 180},
    "macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
    "cohen_kappa": {"type": "number", "minimum": 0, "maximum": 1},
    "gold_support_by_verdict": {"$ref": "#/definitions/verdict_support"},
    "platform_metrics": {
      "type": "object",
      "required": ["carla", "metadrive"],
      "properties": {
        "carla": {"$ref": "#/definitions/platform_metric"},
        "metadrive": {"$ref": "#/definitions/platform_metric"}
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "platform_metric": {
      "type": "object",
      "required": ["record_count", "macro_f1", "cohen_kappa", "gold_support_by_verdict"],
      "properties": {
        "record_count": {"const": 90},
        "macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "cohen_kappa": {"type": "number", "minimum": 0, "maximum": 1},
        "gold_support_by_verdict": {"$ref": "#/definitions/verdict_support"}
      },
      "additionalProperties": false
    },
    "verdict_support": {
      "type": "object",
      "required": ["satisfied", "violated", "unknown"],
      "properties": {
        "satisfied": {"type": "integer", "minimum": 0},
        "violated": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
