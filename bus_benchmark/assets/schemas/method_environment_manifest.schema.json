{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/method_environment_manifest.schema.json",
  "title": "Frozen method execution environment manifest",
  "type": "object",
  "required": [
    "schema_version",
    "decision_status",
    "runtime_kind",
    "executable",
    "runtime_version",
    "locked_dependencies"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "decision_status": {"enum": ["draft", "frozen"]},
    "runtime_kind": {"enum": ["python", "native_command"]},
    "executable": {"$ref": "#/definitions/fileBinding"},
    "python_environment_root": {"type": "string", "minLength": 1},
    "python_environment_control_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/fileBinding"}
    },
    "runtime_version": {"type": "string", "minLength": 1},
    "locked_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
