{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/platform_capability.schema.json",
  "title": "Platform capability decisions bound to ontology and fixtures",
  "type": "object",
  "required": [
    "platform",
    "decision_status",
    "method_independent",
    "ontology_id",
    "ontology_sha256",
    "concepts"
  ],
  "properties": {
    "platform": {"enum": ["carla", "metadrive"]},
    "decision_status": {"const": "confirmed"},
    "method_independent": {"const": true},
    "ontology_id": {"type": "string", "minLength": 1},
    "ontology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "definition_sha256",
          "status",
          "evidence_mode",
          "rationale",
          "fixture_case_ids",
          "coverage_scope",
          "uncovered_route",
          "deterministic_argument_values"
        ],
        "properties": {
          "concept_id": {"type": "string", "minLength": 1},
          "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["native", "constructible", "judge_required", "sidecar_only", "unsupported"]},
          "evidence_mode": {"enum": ["native_observation", "constructed_native", "judge", "sidecar", "none"]},
          "rationale": {"type": "string", "minLength": 1},
          "fixture_case_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "coverage_scope": {
            "enum": ["full_definition", "registered_values_only"]
          },
          "uncovered_route": {"enum": ["not_applicable", "judge"]},
          "deterministic_argument_values": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "object"}
          },
          "evidence_binding": {
            "type": "object",
            "required": ["kind", "sha256"],
            "properties": {
              "kind": {"const": "extractor"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
