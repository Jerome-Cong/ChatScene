{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/platform_fixture_review.schema.json",
  "title": "Single-reviewer platform fixture or capability human gold",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_type",
    "gold_record_id",
    "review_kind",
    "subject_id",
    "platform",
    "subject_sha256",
    "audit_subject_sha256",
    "ontology_definition_sha256",
    "metadrive_pg_registry_sha256",
    "metadrive_pg_token_registry_sha256",
    "input_contract",
    "reviewer",
    "review_status",
    "decision_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "workflow_type": {"const": "platform_fixture_capability_human_gold"},
    "gold_record_id": {"$ref": "#/definitions/sha256"},
    "review_kind": {"enum": ["fixture_case", "capability_status", "registry_implementation"]},
    "subject_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["carla", "metadrive", "cross_platform"]},
    "subject_sha256": {"$ref": "#/definitions/sha256"},
    "audit_subject_sha256": {"$ref": "#/definitions/sha256"},
    "ontology_definition_sha256": {"$ref": "#/definitions/sha256"},
    "metadrive_pg_registry_sha256": {"$ref": "#/definitions/optional_sha256"},
    "metadrive_pg_token_registry_sha256": {"$ref": "#/definitions/optional_sha256"},
    "input_contract": {
      "enum": ["raw_platform_artifact_v0.1", "metadrive_pg_block_scene_v0.1"]
    },
    "reviewer": {"$ref": "#/definitions/label"},
    "review_status": {"const": "complete"},
    "decision_status": {"const": "confirmed"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_sha256": {
      "oneOf": [
        {"$ref": "#/definitions/sha256"},
        {"type": "null"}
      ]
    },
    "label": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "reason"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {"const": "approve"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
