{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/semantic_fixture_input.schema.json",
  "title": "Strict raw platform fixture extractor input",
  "type": "object",
  "required": [
    "schema_version",
    "platform",
    "artifact_format",
    "terminal_status",
    "disposition",
    "artifact"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "platform": {"enum": ["carla", "metadrive"]},
    "artifact_format": {"enum": ["scenic", "metadrive_pg_block_scene_v0.1"]},
    "terminal_status": {"const": "complete"},
    "disposition": {"const": "generate"},
    "artifact": {
      "type": "object",
      "required": ["sha256", "bytes", "text", "dependencies"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "sha256", "bytes"],
            "properties": {
              "kind": {"enum": ["opendrive", "metadrive_pg_token_registry"]},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"platform": {"const": "carla"}}, "required": ["platform"]},
      "then": {
        "properties": {
          "artifact_format": {"const": "scenic"},
          "artifact": {
            "properties": {
              "dependencies": {
                "minItems": 1,
                "maxItems": 1,
                "items": {"properties": {"kind": {"const": "opendrive"}}}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"platform": {"const": "metadrive"}}, "required": ["platform"]},
      "then": {
        "properties": {
          "artifact_format": {"const": "metadrive_pg_block_scene_v0.1"},
          "artifact": {
            "properties": {
              "dependencies": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {"kind": {"const": "metadrive_pg_token_registry"}}
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
