{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chatscene.local/schemas/uqh_assessor_output.schema.json",
  "title": "Raw independent UQH assessor output",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "reason_codes",
    "evidence",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "verdict": {"enum": ["valid", "invalid"]},
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["response_stream", "byte_start", "byte_end", "bytes_sha256"],
        "properties": {
          "response_stream": {"enum": ["stdout", "stderr"]},
          "byte_start": {"type": "integer", "minimum": 0},
          "byte_end": {"type": "integer", "minimum": 0},
          "bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"verdict": {"const": "valid"}},
        "required": ["verdict"]
      },
      "then": {
        "properties": {"reason_codes": {"minItems": 1}}
      }
    }
  ],
  "additionalProperties": false
}
